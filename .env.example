# Copy to .env and adjust. .env is git-ignored and must never be committed.
#
# Every value below is also the default baked into docker-compose.yml, so `make up`
# works without a .env at all. They are development values for containers published on
# 127.0.0.1 and are not safe anywhere else.

# --- data services: read by docker-compose.yml today ------------------------------

POSTGRES_USER=researchmind
POSTGRES_PASSWORD=researchmind
POSTGRES_DB=researchmind
POSTGRES_PORT=5432

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

REDIS_PASSWORD=researchmind
REDIS_PORT=6379

# --- connection strings: read by the application from phase 2 onward --------------
# Nothing reads these yet. They are listed here because they are derived from the
# values above and splitting them across two files would be perverse.

DATABASE_URL=postgresql://researchmind:researchmind@127.0.0.1:5432/researchmind
REDIS_URL=redis://:researchmind@127.0.0.1:6379/0
QDRANT_URL=http://127.0.0.1:6333

# --- provider credentials: read from phase 3 onward -------------------------------
# Nothing reads these yet either. Leave them blank until the provider layer exists;
# an unused key in a shell history is a leaked key for no benefit.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
